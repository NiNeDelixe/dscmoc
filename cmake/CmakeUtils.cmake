# log(<LEVEL> <message...>)
# LEVEL: DEBUG | INFO | WARN | ERROR | FATAL
function(log LEVEL)
    string(TOUPPER "${LEVEL}" LEVEL_UPPER)
    string(JOIN " " MSG ${ARGN})

    if(LEVEL_UPPER STREQUAL "DEBUG")
        message(DEBUG "[DEBUG] ${MSG}")
    elseif(LEVEL_UPPER STREQUAL "INFO")
        message(STATUS "[INFO] ${MSG}")
    elseif(LEVEL_UPPER STREQUAL "WARN")
        message(WARNING "[WARN] ${MSG}")
    elseif(LEVEL_UPPER STREQUAL "ERROR")
        message(SEND_ERROR "[ERROR] ${MSG}")
    elseif(LEVEL_UPPER STREQUAL "FATAL")
        message(FATAL_ERROR "[FATAL] ${MSG}")
    else()
        message(STATUS "[${LEVEL_UPPER}] ${MSG}")
    endif()
endfunction()

# log_var(<var> [<var>...])
function(log_var)
    foreach(_v IN LISTS ARGN)
        if(DEFINED ${_v})
            log(DEBUG "${_v} = '${${_v}}'")
        else()
            log(WARN "Переменная '${_v}' не определена")
        endif()
    endforeach()
endfunction()